# Geant4 Macro Template: Dual-Mode Collimator + Compton Multi-Condition Simulation
/run/initialize

# Physics check: G4EmLivermorePhysics registered in PhysicsList
/process/em/fluo true
/process/em/auger true
/process/em/pixe false

# Example Dual-Isotope Mixed Scene: Am-241 (59.5 keV) + Cs-137 (661.7 keV)
/gps/source/intensity 1.0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre -120.0 95.0 500.0 mm
/gps/ang/type iso
/gps/ang/mintheta 165. deg
/gps/ang/maxtheta 180. deg
/gps/ene/type Mono
/gps/ene/mono 59.5 keV

/gps/source/add 1.0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 115.0 -85.0 500.0 mm
/gps/ang/type iso
/gps/ang/mintheta 165. deg
/gps/ang/maxtheta 180. deg
/gps/ene/type Mono
/gps/ene/mono 661.7 keV

/run/printProgress 50000
/run/beamOn 200000
